# 拙愚智能 模型配置模板
#
# 复制为 .env 后填入真实凭据：
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会提交到仓库。
# 环境变量优先级高于 .env，CI 里直接 export 同名变量即可覆盖。

# Anthropic 兼容端点（示例为 MiniMax 的 Anthropic 兼容接口）
INVEST_ANTHROPIC_BASE_URL=https://api.minimax.cn/anthropic
INVEST_ANTHROPIC_AUTH_TOKEN=your-token-here

# 模型映射
INVEST_ANTHROPIC_MODEL=MiniMax-M3.1-Flash
INVEST_ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3.1-Flash
INVEST_ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3
INVEST_ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3.1-Flash

# 以下为历史遗留键，当前代码不读取，可留可删
INVEST_STOCK_PROVIDER_MANAGED_BY_HOST=1
INVEST_STOCK_AUTO_MODE_SERVER=0
INVEST_STOCK_AUTO_COMPACT_WINDOW=1000000
